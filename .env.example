# Network
NYMOR_NETWORK=stellar:testnet          # switch to stellar:pubnet only after Phase 4 passes
NYMOR_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Facilitator (OZ Channels) — required on both testnet and mainnet, or the
# seller crashes at startup with "no supported payment kinds loaded from any
# facilitator". Generate a key at https://channels.openzeppelin.com/testnet/gen
# (testnet) or https://channels.openzeppelin.com/gen (mainnet).
NYMOR_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
NYMOR_OZ_API_KEY=

# Seller (nymor-resources)
NYMOR_SELLER_PAYTO_ADDRESS=G...
NYMOR_RESOURCES_PORT=3001

# Buyer (nymor-server, the agent's wallet)
NYMOR_BUYER_STELLAR_PRIVATE_KEY=S...   # never log or print this. .gitignore'd.

# Spend policy
NYMOR_SESSION_CAP_USD=1.00
NYMOR_PER_CALL_MAX_USD=0.05
# Prefer absolute paths here. nymor-server, demo/run-demo.ts, and MCP clients
# each launch with a different working directory, so a relative path like
# "./nymor.ledger.json" silently resolves to a different file per launcher —
# which looks like missing/duplicated spend history. An absolute path keeps
# every entrypoint pointed at the same file.
NYMOR_LEDGER_PATH=./nymor.ledger.json
NYMOR_REGISTRY_PATH=./nymor.registry.json

# Real summarization resource — OpenRouter (OpenAI-compatible), pointed at a
# free-tier model so /summarize makes a real LLM call at zero cost. Get a key
# at https://openrouter.ai/keys (no card required for :free models).
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OpenRouter's ":free" model lineup changes over time and free-tier models
# can be rate-limited on a shared pool; if this one starts 404ing or 429ing,
# check https://openrouter.ai/models?fmt=cards&max_price=0 for a current
# alternative and swap OPENROUTER_MODEL — no code changes needed.

# Logging
NYMOR_LOG_LEVEL=info
NYMOR_LOG_PATH=./nymor.log
