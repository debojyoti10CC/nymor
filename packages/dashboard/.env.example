# All VITE_-prefixed vars are bundled into the client-side JS at build time —
# never put secrets here. Copy to .env.local for local dev.

VITE_NYMOR_RESOURCES_URL=http://localhost:3001
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_STELLAR_NETWORK=stellar:testnet
# Same value as NYMOR_SELLER_PAYTO_ADDRESS in the root .env — public info,
# safe to bundle (it's the address everyone already pays on-chain).
VITE_SELLER_PAYTO_ADDRESS=
